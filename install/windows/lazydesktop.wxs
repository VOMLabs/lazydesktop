<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="LazyDesktop"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="LazyDesktop Team"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
           InstallerVersion="200">
    <SummaryInformation Manufacturer="LazyDesktop Team"
                        Description="A KDE-native Git GUI alternative"/>

    <MajorUpgrade DowngradeErrorMessage="A newer version of LazyDesktop is already installed."/>

    <Media Id="1" Cabinet="lazydesktop.cab" EmbedCab="yes"/>

    <!-- Icon for Add/Remove Programs -->
    <Icon Id="AppIcon" SourceFile="$(var.SourceDir)/data/icons/hicolor/scalable/apps/lazydesktop.svg"/>
    <Property Id="ARPPRODUCTICON" Value="AppIcon"/>

    <!-- Features.
         The deployed application files (exe, Qt DLLs, plugins) are generated
         into the "LazyDesktopBinaries" component group by deploy-msi.ps1. -->
    <Feature Id="MainFeature" Title="LazyDesktop" Level="1" ConfigurableDirectory="INSTALLDIR">
      <ComponentGroupRef Id="LazyDesktopBinaries"/>
      <ComponentRef Id="StartMenuShortcut"/>
      <ComponentRef Id="DesktopShortcut"/>
    </Feature>

    <!-- UI -->
    <UI Id="LazyDesktopUI">
      <ui:WixUI Id="WixUI_InstallDir"/>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="1"/>
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="1"/>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="1" Condition="WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;&quot;"/>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="WIXUI_INSTALLDIR" Order="2"/>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Order="1"/>
    </UI>

    <UIRef Id="WixUI_Common"/>
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR"/>

    <!-- Directory structure. The contents of INSTALLDIR come from the
         generated fragment; only the root directory is declared here. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="LazyDesktop">
        <!-- components generated by deploy-msi.ps1 are added here -->
      </Directory>
    </StandardDirectory>

    <!-- Start Menu -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuDir" Name="LazyDesktop">
        <Component Id="StartMenuShortcut">
          <Shortcut Id="AppShortcut"
                    Name="LazyDesktop"
                    Description="A KDE-native Git GUI alternative"
                    Target="[INSTALLDIR]lazydesktop.exe"
                    WorkingDirectory="INSTALLDIR"/>
          <Shortcut Id="UninstallShortcut"
                    Name="Uninstall LazyDesktop"
                    Target="[System64Folder]msiexec.exe"
                    Arguments="/x [ProductCode]"/>
          <RemoveFolder Id="StartMenuDir" On="uninstall"/>
          <RegistryValue Root="HKCU" Key="Software\LazyDesktop" Name="Installed" Type="integer" Value="1"/>
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Desktop shortcut -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut">
        <Shortcut Id="DesktopAppShortcut"
                  Name="LazyDesktop"
                  Description="A KDE-native Git GUI alternative"
                  Target="[INSTALLDIR]lazydesktop.exe"
                  WorkingDirectory="INSTALLDIR"/>
        <RegistryValue Root="HKCU" Key="Software\LazyDesktop" Name="DesktopShortcut" Type="integer" Value="1"/>
      </Component>
    </StandardDirectory>
  </Package>
</Wix>
